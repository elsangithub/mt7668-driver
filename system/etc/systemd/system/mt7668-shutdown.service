[Unit]
Description=Unbind SDIO controller before shutdown/reboot for clean MT7668 reset
DefaultDependencies=no
Before=shutdown.target reboot.target halt.target

[Service]
Type=oneshot
# On Amlogic TV boxes (FiberHome HG680-FJ), the MT7668 module is powered by always-on rails.
# When a software reboot occurs, the SoC resets while MT7668 stays energized.
# Unbinding the SDIO controller (ffe03000.sd) cleanly disconnects the SDIO bus before reboot,
# preventing the MT7668 state machine from locking up on warm boot (error -110).
ExecStart=/bin/sh -c 'if lsmod | grep -q "^wlan_mt7668"; then for d in /sys/bus/platform/drivers/*mmc*/ffe03000* /sys/bus/platform/drivers/*sd*/ffe03000*; do [ -e "$d" ] && echo "${d##*/}" > "$(dirname "$d")/unbind" 2>/dev/null || true; done; fi'
TimeoutStartSec=2

[Install]
WantedBy=shutdown.target reboot.target halt.target
